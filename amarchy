#!/usr/bin/env bash
# Omarchy personal-portability: export/import of the live customization.
# Modes: 1 = export (source machine), 2 = import (target machine).
# Every option is ON by default; digits toggle; `a`/`n` all/none; Enter applies.

set -uo pipefail

CFG="$HOME/.config"
ST="$HOME/.local/state/omarchy"
PAY="${OMARCHY_MIG_PAYLOAD:-$HOME/omarchy-personal.tar.gz}"
N=0                    # selected counter
IDX=0                  # group cursor

# ---------------------------------------------------------------- groups ----
# Format per entry: "label|<path-spec>[ <path-spec>...]"
#   c:<rel>  -> $HOME/.config/<rel>
#   s:<rel>  -> $HOME/.local/state/omarchy/<rel>
#   P        -> pacman -Qqen  (repo)
#   A        -> pacman -Qqm   (AUR)
LBL=(); SPEC=()
add() { LBL[$((++IDX))]="$1"; SPEC[$IDX]="$2"; }
N=$IDX

add "Tema activo · tahoe-dark"            "c:omarchy/themes/tahoe-dark s:current/theme s:current/theme.name s:current/theme.generation s:current/background"
add "Temas extra (dos-moos, hermarchy, noir)" "c:omarchy/themes/dos-moos c:omarchy/themes/hermarchy c:omarchy/themes/noir"
add "Fondo propio del tema"               "c:omarchy/backgrounds/tahoe-dark/rrt1.jpg"
add "Layout de la barra superior"         "c:omarchy/shell.json c:omarchy/shell.toml"
add "Modulo QML system-monitor"           "c:omarchy/bar/modules/system-monitor.qml"
add "Widgets propios (clock, kairos, monitor, weather, mouse-mapper, notifications)" \
                                          "c:omarchy/plugins/amartin.clock c:omarchy/plugins/amartin.kairos c:omarchy/plugins/amartin.monitor c:omarchy/plugins/amartin.weather c:omarchy/plugins/amartin.mouse-mapper c:omarchy/plugins/amartin.notifications"
add "Dock (plugin + dock.json)"           "c:omarchy/plugins/dock c:omarchy/dock.json"
add "Plugin omdrop (AirDrop)"             "c:omarchy/plugins/netmojo.omdrop"
add "Hyprland personal (13 archivos)"     "c:hypr"
add "Iconos (Yaru-blue-dark)"             "c:omarchy/themes/tahoe-dark/icons.theme A:yaru-icon-theme"
add "Terminales (ghostty, alacritty, foot, kitty)" "c:ghostty/config c:alacritty/alacritty.toml c:foot/foot.ini c:kitty/kitty.conf"
add "Prompt y monitores TUI (starship, btop)" "c:starship.toml c:btop/btop.conf c:btop/themes"
add "Dictado (voxtype)"                   "c:voxtype/config.toml"
add "Metodo de entrada (fcitx5)"          "c:fcitx5"
add "Mime, terminales XDG, user-dirs, bookmarks GTK" "c:mimeapps.list c:xdg-terminals.list c:user-dirs.dirs c:gtk-3.0/bookmarks"
add "Idioma, branding, menu, defaults"    "c:omarchy/language c:omarchy/branding c:omarchy/extensions/omarchy-menu.jsonc c:omarchy/defaults"
add "Hooks (theme-set.d, post-update.d, ...)" "c:omarchy/hooks"
add "Picker de compartir pantalla"        "c:hyprland-preview-share-picker/config.yaml"
add "Estado runtime (clima, mouse-mapper)" "s:settings/weather.json s:mouse-mapper.json"
add "Paquetes del repositorio"            "P"
add "Paquetes AUR"                        "A"
TOTAL=$IDX
SEL=(); for ((i=1;i<=TOTAL;i++)); do SEL[i]=1; done
# ------------------------------------------------------------- helpers ------
cpath() { local p=${1#c:}; printf '%s\n' "$CFG/$p"; }   # c:omarchy/... -> $CFG/omarchy/...
spath() { local p=${1#s:}; printf '%s\n' "$ST/$p"; }

human() { # bytes -> compact, integer math only (no bc dependency)
  local b=${1:-0}
  if   (( b >= 1048576 )); then printf '%d.%d MB' $((b/1048576)) $(( (b%1048576)*10/1048576 ))
  elif (( b >= 1024 ));    then printf '%d.%d KB' $((b/1024))    $(( (b%1024)*10/1024 ))
  else printf '%d B' "$b"; fi
}

# per-group live status: "files|bytes"
stat_group() {
  local i=$1 f=0 b=0 p n
  read -ra P <<<"${SPEC[i]}"
  for p in "${P[@]}"; do
    case $p in
      c:*) n=$(cpath "$p");;
      s:*) n=$(spath "$p");;
      P)   f=$(( f + $(pacman -Qqen 2>/dev/null | wc -l) )); continue;;
      A)   f=$(( f + $(pacman -Qqm  2>/dev/null | wc -l) )); continue;;
      A:*) f=$(( f + $(pacman -Ql "${p#A:}" 2>/dev/null | grep -c '/$' || echo 1) )); continue;;
      *)   n=$p;;
    esac
    if [[ -d $n ]]; then
      local nf nb; nf=$(find "$n" -type f -not -path '*/.git/*' -not -name '*.pyc' | wc -l)
      nb=$(find "$n" -type f -not -path '*/.git/*' -not -name '*.pyc' -printf '%s\n' | awk '{s+=$1} END{print s+0}')
      f=$((f+nf)); b=$((b+nb))
    elif [[ -f $n ]]; then
      f=$((f+1)); b=$((b+$(wc -c <"$n")))
    fi
  done
  printf '%s|%s' "$f" "$b"
}

mark() { [[ ${SEL[$1]} == 1 ]] && printf '\033[32m[x]\033[0m' || printf '\033[90m[ ]\033[0m'; }

menu() {
  local sel=0 s f b
  printf '\n\033[1mOmarchy · personalizacion (%s grupos)\033[0m  payload: %s\n' "$TOTAL" "${PAY:-(auto)}"
  printf '%-4s %-5s %-52s %9s %9s\n' '#' 'on' 'grupo' 'arch' 'tam'
  for ((i=1;i<=TOTAL;i++)); do
    s=$(stat_group "$i"); f=${s%%|*}; b=${s##*|}
    [[ ${SEL[i]} == 1 ]] && sel=$((sel+1))
    printf '%-4s %-15s %-52s %9s %9s\n' "$i" "$(mark "$i")" "${LBL[i]}" "${f:-0}" "$(human "${b:-0}")"
  done
  printf '\033[1mSeleccionados: %s/%s\033[0m\n' "$sel" "$TOTAL"
}

# --------------------------------------------------------------- export -----
do_export() {
  local stage; stage=$(mktemp -d)
  mkdir -p "$stage/config" "$stage/state"
  local i p n sel=0
  for ((i=1;i<=TOTAL;i++)); do
    [[ ${SEL[i]} == 1 ]] || continue
    sel=$((sel+1))
    printf '[%2d/%s] \033[36mexport\033[0m %s ... ' "$i" "$TOTAL" "${LBL[i]}"
    read -ra P <<<"${SPEC[i]}"
    for p in "${P[@]}"; do
      case $p in
        c:*) n=$(cpath "$p"); [[ -e $n ]] || continue
             mkdir -p "$stage/config/$(dirname "${p#c:}")"
             cp -a "$n" "$stage/config/${p#c:}";;
        s:*) n=$(spath "$p"); [[ -e $n ]] || continue
             mkdir -p "$stage/state/$(dirname "${p#s:}")"
             cp -a "$n" "$stage/state/${p#s:}";;
        P)   pacman -Qqen 2>/dev/null >"$stage/pkgs-repo.txt";;
        A)   pacman -Qqm  2>/dev/null >"$stage/pkgs-aur.txt";;
      esac
    done
    printf '\033[32mok\033[0m\n'
  done
  printf 'hyprland=%s\nomarchy=%s\nfont=%s\nicons=%s\nterminal=%s\nkb_layout=%s\nkairos=%s\nweather=%s\n' \
    "$(hyprctl version 2>/dev/null | awk '/^Hyprland/{print $2; exit}')" \
    "$(omarchy version 2>/dev/null | head -1)" \
    "$(awk -F' = ' '/^font-family/{gsub(/"/,"",$2);print $2; exit}' "$CFG/ghostty/config" 2>/dev/null)" \
    "$(cat "$CFG/omarchy/themes/tahoe-dark/icons.theme" 2>/dev/null)" \
    "$(awk '!/^#/ && NF {print; exit}' "$CFG/xdg-terminals.list" 2>/dev/null)" \
    "$(hyprctl getoption input:kb_layout 2>/dev/null | awk '/^str:/{print $2}')" \
    "http://kairos:8787/api/metrics" \
    "$(jq -r '.name // "?"' "$ST/settings/weather.json" 2>/dev/null)" \
    >"$stage/manifest.txt"
  # 0.56 JSON: width/height/refreshRate/scale/transform are the populated keys.
  { printf 'monitors='
    hyprctl monitors -j 2>/dev/null | jq -r \
      '[.[]|"\(.name):\(.width)x\(.height)@\(.refreshRate):\(.scale):\(.transform)"]|join(",")'
    printf 'gen=%s\n' "$(cat "$ST/current/theme.generation" 2>/dev/null)"; } >>"$stage/manifest.txt"
  ( cd "$stage" && tar --exclude=.git --exclude=__pycache__ -czf "$PAY" . )
  cp "$stage/manifest.txt" "$PAY.manifest" 2>/dev/null || true
  local kb; kb=$(( $(wc -c <"$PAY") / 1024 ))
  printf '\n\033[32m✔\033[0m %s  (%s KB, %s grupos)\n' "$PAY" "$kb" "$sel"
  rm -rf "$stage"
}

# -------------------------------------------------- target-machine audit ---
# Reads the source manifest from the payload and compares it with the live
# target. Prints differences, then applies safe automatic adaptations.
audit() {
  local m="$1" k v
  local -A SRC=()
  while IFS='=' read -r k v; do [[ -n $k ]] && SRC["$k"]=$v; done <"$m"
  printf '\n\033[1mAjustes dependientes de esta maquina\033[0m\n'

  # 1 · Hyprland version -> rounding_power / hyprpm ABI
  local hv; hv=$(hyprctl version 2>/dev/null | awk '/^Hyprland/{print $2; exit}')
  if [[ ${SRC[hyprland]} != "$hv" ]]; then
    printf '  \033[33m!\033[0m hyprland: origen %s -> destino %s\n' "${SRC[hyprland]:-?}" "${hv:-sin Hyprland}"
    [[ ${hv#0.} =~ ^([0-9]+) ]] && (( ${BASH_REMATCH[1]} >= 55 )) \
      && echo "      rounding_power 2.0 soportado; si es <0.55 se ignora (esquinas triangulares)." \
      || echo "      Hyprland <0.55: tahoe-overrides.lua usa rounding_power=2.0, se ignorara."
    echo "      -> hyprpm update reconstruye hyprbars/hymission contra esta build."
  else
    printf '  \033[32m=\033[0m hyprland %s\n' "$hv"
  fi

  # 2 · omarchy release
  local ov; ov=$(omarchy version 2>/dev/null | head -1)
  [[ ${SRC[omarchy]} == "$ov" ]] \
    && printf '  \033[32m=\033[0m omarchy %s\n' "$ov" \
    || printf '  \033[33m!\033[0m omarchy: origen %s -> destino %s (defaults pueden variar)\n' "${SRC[omarchy]:-?}" "${ov:-?}"

  # 3 · monitors: rewrite monitors.lua to the real target topology
  local mons; mons=$(hyprctl monitors -j 2>/dev/null | jq -r \
    '[.[]|"\(.name):\(.width)x\(.height)@\(.refreshRate):\(.scale):\(.transform)"]|join(",")')
  if [[ -n $mons && $mons != "${SRC[monitors]}" ]]; then
    printf '  \033[33m!\033[0m monitores: origen [%s] -> destino [%s]\n' "${SRC[monitors]:-?}" "$mons"
    local out="$CFG/hypr/monitors.lua" n nm wh sc tf
    : >"$out"
    printf -- '-- autogenerado por amarchy (destino)\nhl.env("GDK_SCALE", "1")\n' >>"$out"
    IFS=',' read -ra MM <<<"$mons"
    for n in "${MM[@]}"; do
      IFS=':' read -r nm wh sc tf <<<"$n"
      if [[ ${tf:-0} != 0 ]]; then
        printf 'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = %s, transform = %s })\n' \
          "$nm" "${wh/@*}" "${sc:-1}" "$tf" >>"$out"
      else
        printf 'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = %s })\n' \
          "$nm" "${wh/@*}" "${sc:-1}" >>"$out"
      fi
    done
    echo "      -> reescrito $out con la topologia real (${#MM[@]} pantalla(s)); mode = WxH del modo actual."
  else
    printf '  \033[32m=\033[0m monitores [%s]\n' "${mons:-ninguno}"
  fi

  # 4 · font present?
  local fn=${SRC[font]:-JetBrainsMono Nerd Font}
  if fc-list : family 2>/dev/null | grep -qi "${fn%%,*}"; then
    printf '  \033[32m=\033[0m fuente %s instalada\n' "$fn"
  else
    printf '  \033[33m!\033[0m fuente %s NO instalada\n' "$fn"
    local alt=JetBrainsMono
    fc-list : family 2>/dev/null | grep -qi "$alt" && { pacman -S --needed --noconfirm ttf-jetbrains-mono-nerd-basic >/dev/null 2>&1 && echo "      -> instalado ttf-jetbrains-mono-nerd-basic"; } \
      || echo "      -> instala ttf-jetbrains-mono-nerd-basic; los 4 conf de terminal la referencian."
  fi

  # 5 · icon theme package
  local ic=${SRC[icons]:-Yaru-blue-dark}
  if [[ -d /usr/share/icons/$ic ]]; then
    printf '  \033[32m=\033[0m iconos %s presentes\n' "$ic"
  else
    printf '  \033[33m!\033[0m iconos %s faltan -> instalando yaru-icon-theme\n' "$ic"
    pacman -S --needed --noconfirm yaru-icon-theme >/dev/null 2>&1 && echo "      ok" || echo "      (pendiente)"
  fi
  # 6 · preferred terminal exists as desktop entry?
  local tm=${SRC[terminal]:-com.mitchellh.ghostty.desktop}
  if ls /usr/share/applications/$tm >/dev/null 2>&1; then
    printf '  \033[32m=\033[0m terminal %s\n' "$tm"
  else
    local f
    for f in com.mitchellh.ghostty.desktop org.codeberg.fsfoss.terminal.kitty.desktop org.codeberg.fsfoss.terminal.foot.desktop; do
      [[ -e /usr/share/applications/$f ]] && { printf '%s\n' "$f" >"$CFG/xdg-terminals.list"
        printf '  \033[33m!\033[0m %s ausente -> xdg-terminals.list = %s\n' "$tm" "$f"; break; }
    done
  fi

  # 7 · keyboard layout: keep target's live value, note drift
  local kl; kl=$(hyprctl getoption input:kb_layout 2>/dev/null | awk '/^str:/{print $2}')
  [[ -n $kl && $kl != "${SRC[kb_layout]}" ]] && printf '  \033[33m!\033[0m kb_layout activo %s (origen: %s)\n' "$kl" "${SRC[kb_layout]:-nulo}" \
    || printf '  \033[32m=\033[0m kb_layout %s\n' "${kl:-${SRC[kb_layout]:-default}}"

  # 8 · kairos endpoint reachable?
  if [[ -n ${SRC[kairos]:-} ]] && curl -fsS -m 3 -o /dev/null "${SRC[kairos]}" 2>/dev/null; then
    printf '  \033[32m=\033[0m kairos %s responde\n' "${SRC[kairos]}"
  else
    printf '  \033[33m!\033[0m kairos %s sin respuesta -> el widget amartin.kairos queda vacio\n' "${SRC[kairos]:-?}"
  fi

  # 9 · weather city
  printf '  \033[36m·\033[0m clima: %s\n' "${SRC[weather]:-?}"

  # 10 · missing payload entries
  printf '\n'
}

# --------------------------------------------------------------- import -----
do_import() {
  [[ -f $PAY ]] || { printf '\033[31m✘\033[0m falta el payload %s\n' "$PAY"; return 1; }
  local stage; stage=$(mktemp -d)
  tar -xzf "$PAY" -C "$stage"
  local i p n sel=0 t0=$SECONDS
  for ((i=1;i<=TOTAL;i++)); do
    [[ ${SEL[i]} == 1 ]] || continue
    sel=$((sel+1))
    printf '[%2d/%s] \033[36mimport\033[0m %s ... ' "$i" "$TOTAL" "${LBL[i]}"
    read -ra P <<<"${SPEC[i]}"
    local cfgp=() stp=()
    for p in "${P[@]}"; do
      case $p in c:*) cfgp+=("config/${p#c:}");; s:*) stp+=("state/${p#s:}");; esac
    done
    ((${#cfgp[@]})) && tar -xf "$PAY" -C "$CFG" --strip-components=1 -- "${cfgp[@]}"
    ((${#stp[@]}))  && tar -xf "$PAY" -C "$ST" --strip-components=1 -- "${stp[@]}"
    case " ${SPEC[i]} " in
      *P*) [[ -f $stage/pkgs-repo.txt ]] && { pacman -S --needed --noconfirm $(cat "$stage/pkgs-repo.txt"); };;
      *A*) [[ -f $stage/pkgs-aur.txt ]] && { yay -S --needed --noconfirm $(cat "$stage/pkgs-aur.txt"); };;
    esac
    printf '\033[32mok\033[0m\n'
  done
  [[ -f $stage/manifest.txt ]] && audit "$stage/manifest.txt"
  printf '\n\033[32m✔\033[0m %s grupos en %ss\n' "$sel" "$((SECONDS-t0))"
  rm -rf "$stage"
}

finalize() {
  printf '\n\033[1mAplicando\033[0m\n'
  printf '  · hyprpm update\n'; hyprpm update --noconfirm >/dev/null 2>&1 && echo "    ok" || echo "    (omitiendo: sin hyprpm)"
  printf '  · omarchy theme set tahoe-dark\n'; omarchy theme set tahoe-dark >/dev/null 2>&1 && echo "    ok" || echo "    (sin cambio)"
  printf '  · omarchy restart shell\n'; omarchy restart shell >/dev/null 2>&1 && echo "    ok" || echo "    (sin cambio)"
  printf '  · omarchy restart terminal\n'; omarchy restart terminal >/dev/null 2>&1 && echo "    ok" || echo "    (sin cambio)"
  printf '  · hyprctl reload\n'; hyprctl reload >/dev/null 2>&1 && echo "    ok" || echo "    (sin cambio)"
  printf '  · hyprctl configerrors -> '; hyprctl configerrors 2>&1 | head -3
}

# ------------------------------------------------------------ interactive ---
mode=
[[ -f $PAY ]] && mode=import || mode=export
[[ -d $CFG/omarchy ]] && mode=${mode:-export}

while true; do
  menu
  printf '\n(1-%s) alternar · a todos · n ninguno · r reset · e export · i import · q salir\n> ' "$TOTAL"
  read -r ans || break
  case $ans in
    ''|*[!0-9a-zA-Z]*) [[ -z $ans ]] && { [[ $mode == import ]] && do_import || do_export; finalize; break; };;
  esac
  case $ans in
    a|A) for ((i=1;i<=TOTAL;i++)); do SEL[i]=1; done;;
    n|N) for ((i=1;i<=TOTAL;i++)); do SEL[i]=0; done;;
    r|R) for ((i=1;i<=TOTAL;i++)); do SEL[i]=1; done;;
    e|E) do_export;;
    i|I) do_import; finalize;;
    q|Q) break;;
    *)   if [[ $ans =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= TOTAL )); then
           [[ ${SEL[ans]} == 1 ]] && SEL[ans]=0 || SEL[ans]=1
         else printf '\033[33mopción %s fuera de rango\033[0m\n' "$ans"; fi;;
  esac
done
