#!/usr/bin/env bash
# amarchy · portabilidad de la personalizacion Omarchy
#   export  -> empaqueta la config viva en $PAY (+ $PAY.manifest)
#   import  -> despliega el payload y audita las diferencias con esta maquina
# Todos los grupos vienen marcados. Digitos alternan, Enter aplica el modo inicial.

set -uo pipefail

CFG="$HOME/.config"
ST="$HOME/.local/state/omarchy"
PAY="${OMARCHY_MIG_PAYLOAD:-$HOME/omarchy-personal.tar.gz}"

# ─── definicion de grupos ───────────────────────────────────────────────────
# tokens de SPEC:  c:<rel>  -> $HOME/.config/<rel>
#                  s:<rel>  -> $HOME/.local/state/omarchy/<rel>
#                  P        -> pacman -Qqen (repo)
#                  A        -> pacman -Qqm  (AUR)
#                  A:<pkg>  -> paquete concreto
LBL=(); SPEC=(); ICO=()
add() { local n=$(( ${#LBL[@]} + 1 )); ICO[n]=$1; LBL[n]=$2; SPEC[n]=$3; }

add "▲" "Tema activo · tahoe-dark"                    "c:omarchy/themes/tahoe-dark s:current/theme s:current/theme.name s:current/theme.generation s:current/background"
add "◈" "Temas extra (dos-moos, hermarchy, noir)"     "c:omarchy/themes/dos-moos c:omarchy/themes/hermarchy c:omarchy/themes/noir"
add "▣" "Fondo propio del tema"                       "c:omarchy/backgrounds/tahoe-dark/rrt1.jpg"
add "☰" "Layout de la barra superior"                 "c:omarchy/shell.json c:omarchy/shell.toml"
add "▤" "Modulo QML system-monitor"                   "c:omarchy/bar/modules/system-monitor.qml"
add "◉" "Widgets propios (6) · clock kairos monitor weather mouse-mapper notifications" \
                                                     "c:omarchy/plugins/amartin.clock c:omarchy/plugins/amartin.kairos c:omarchy/plugins/amartin.monitor c:omarchy/plugins/amartin.weather c:omarchy/plugins/amartin.mouse-mapper c:omarchy/plugins/amartin.notifications"
add "⊟" "Dock · plugin + dock.json"                   "c:omarchy/plugins/dock c:omarchy/dock.json"
add "⇄" "Plugin omdrop (AirDrop)"                     "c:omarchy/plugins/netmojo.omdrop"
add "⌘" "Hyprland · 13 archivos Lua/conf"             "c:hypr"
add "✦" "Iconos · Yaru-blue-dark"                     "c:omarchy/themes/tahoe-dark/icons.theme A:yaru-icon-theme"
add "▸" "Terminales · ghostty alacritty foot kitty"   "c:ghostty/config c:alacritty/alacritty.toml c:foot/foot.ini c:kitty/kitty.conf"
add "≡" "Prompt y TUI · starship btop"                "c:starship.toml c:btop/btop.conf c:btop/themes"
add "♪" "Dictado · voxtype"                           "c:voxtype/config.toml"
add "⌨" "Metodo de entrada · fcitx5"                  "c:fcitx5"
add "↧" "XDG/GTK · mimeapps terminals user-dirs bookmarks" "c:mimeapps.list c:xdg-terminals.list c:user-dirs.dirs c:gtk-3.0/bookmarks"
add "ℹ" "Metadatos · idioma branding menu defaults"   "c:omarchy/language c:omarchy/branding c:omarchy/extensions/omarchy-menu.jsonc c:omarchy/defaults"
add "⚡" "Hooks · theme-set.d post-update.d ..."       "c:omarchy/hooks"
add "◫" "Share picker"                                "c:hyprland-preview-share-picker/config.yaml"
add "◇" "Estado runtime · clima mouse-mapper"         "s:settings/weather.json s:mouse-mapper.json"
add "▦" "Paquetes del repositorio"                    "P"
add "◱" "Paquetes AUR"                                "A"
TOTAL=${#LBL[@]}
SEL=(); for ((i=1;i<=TOTAL;i++)); do SEL[i]=1; done

# ─── helpers ────────────────────────────────────────────────────────────────
cpath() { local p=${1#c:}; printf '%s\n' "$CFG/$p"; }
spath() { local p=${1#s:}; printf '%s\n' "$ST/$p"; }

human() {
  local b=${1:-0}
  if   (( b >= 1048576 )); then printf '%d.%dMB' $((b/1048576)) $(( (b%1048576)*10/1048576 ))
  elif (( b >= 1024 ));    then printf '%d.%dKB' $((b/1024))    $(( (b%1024)*10/1024 ))
  else printf '%dB' "$b"; fi
}

# files|bytes|missing  (los paquetes aportan su numero de archivos instalados)
stat_group() {
  local i=$1 f=0 b=0 m=0 p n
  local -a P=()
  read -ra P <<<"${SPEC[i]}"
  for p in "${P[@]}"; do
    case $p in
      c:*) n=$(cpath "$p");;
      s:*) n=$(spath "$p");;
      P)   f=$(( f + $(pacman -Qqen 2>/dev/null | wc -l) )); continue;;
      A)   f=$(( f + $(pacman -Qqm  2>/dev/null | wc -l) )); continue;;
      A:*) local c; c=$(pacman -Ql "${p#A:}" 2>/dev/null | wc -l)
           (( c > 0 )) && f=$(( f + c )) || m=$((m+1)); continue;;
      *)   n=$p;;
    esac
    if   [[ -d $n ]]; then
      f=$(( f + $(find "$n" -type f -not -path '*/.git/*' -not -name '*.pyc' | wc -l) ))
      b=$(( b + $(find "$n" -type f -not -path '*/.git/*' -not -name '*.pyc' -printf '%s\n' | awk '{s+=$1} END{print s+0}') ))
    elif [[ -f $n ]]; then
      f=$((f+1)); b=$((b+$(wc -c <"$n")))
    else
      m=$((m+1))
    fi
  done
  printf '%s|%s|%s' "$f" "$b" "$m"
}

# Instala una entrada del stage en su destino. Con `src/.` el contenido cae dentro
# del directorio destino (sin el anidamiento t/a/a de `cp -a src dst`) y el rm
# previo deja el resultado identico al del export, sin ficheros huerfanos.
install_entry() { # <stage-root> <dst-root> <rel>
  local src=$1/$3 dst=$2/$3
  [[ -e $src ]] || return 0
  if [[ -d $src ]]; then
    rm -rf "$dst"; mkdir -p "$dst"; cp -a "$src/." "$dst/"
  else
    mkdir -p "$(dirname "$dst")"; cp -a "$src" "$dst"
  fi
}

# ─── render ─────────────────────────────────────────────────────────────────
menu() {
  local sel=0 s f b m t0=$SECONDS
  local hv ov
  hv=$(hyprctl version 2>/dev/null | awk '/^Hyprland/{print $2; exit}')
  ov=$(omarchy version 2>/dev/null | head -1)
  printf '\n\033[1;36m╭─[ amarchy ]\033[0m \033[90momarchy %s · hyprland %s · %s grupos\033[0m\n' \
    "${ov:-?}" "${hv:-?}" "$TOTAL"
  printf '\033[1;36m│\033[0m \033[90mpayload\033[0m %s\n' "${PAY}"
  printf '\033[1;36m├\033[0m \033[2m%-3s %-3s %-52s %6s %8s %3s\033[0m\n' '#' 'on' 'grupo' 'arch' 'tam' 'mis'
  for ((i=1;i<=TOTAL;i++)); do
    s=$(stat_group "$i"); f=${s%%|*}; b=${s#*|}; b=${b%%|*}; m=${s##*|}
    [[ ${SEL[i]} == 1 ]] && sel=$((sel+1))
    if [[ ${SEL[i]} == 1 ]]; then
      printf '\033[1;36m│\033[0m \033[32m%02d\033[0m \033[32m●\033[0m %s \033[1m%s\033[0m' "$i" "${ICO[i]}" "${LBL[i]}"
    else
      printf '\033[1;36m│\033[0m \033[2m%02d ○\033[0m %s \033[2m%s\033[0m' "$i" "${ICO[i]}" "${LBL[i]}"
    fi
    printf ' %6s %8s' "$f" "$(human "$b")"
    (( m > 0 )) && printf ' \033[33m%s\033[0m\n' "$m" || printf ' \033[2m0\033[0m\n'
  done
  printf '\033[1;36m╰─\033[0m \033[1m%s/%s\033[0m seleccionados \033[2m· %.0fs\033[0m\n' "$sel" "$TOTAL" "$((SECONDS-t0))"
}

help() {
  printf '\n\033[1;35mcomandos\033[0m\n'
  printf '  \033[33m1-%s\033[0m  alternar grupo       \033[33ma\033[0m todos   \033[33mn\033[0m ninguno   \033[33mr\033[0m reset\n' "$TOTAL"
  printf '  \033[33me\033[0m  export                 \033[33mi\033[0m import + audit   \033[33ms\033[0m entorno   \033[33mp\033[0m payload\n'
  printf '  \033[33mEnter\033[0m  aplicar modo inicial (%s)   \033[33mh\033[0m esta ayuda   \033[33mq\033[0m salir\n' "$MODE"
}

# ─── export ─────────────────────────────────────────────────────────────────
do_export() {
  local stage; stage=$(mktemp -d)
  mkdir -p "$stage/config" "$stage/state"
  local i p n sel=0 miss=0
  for ((i=1;i<=TOTAL;i++)); do
    [[ ${SEL[i]} == 1 ]] || continue
    sel=$((sel+1))
    printf '\033[36m▸\033[0m \033[2m[%02d/%s]\033[0m %s ' "$i" "$TOTAL" "${LBL[i]}"
    local -a P=()
    read -ra P <<<"${SPEC[i]}"
    for p in "${P[@]}"; do
      case $p in
        c:*) n=$(cpath "$p"); if [[ -e $n ]]; then
               mkdir -p "$stage/config/$(dirname "${p#c:}")"; cp -a "$n" "$stage/config/${p#c:}"
             else miss=$((miss+1)); fi;;
        s:*) n=$(spath "$p"); if [[ -e $n ]]; then
               mkdir -p "$stage/state/$(dirname "${p#s:}")"; cp -a "$n" "$stage/state/${p#s:}"
             else miss=$((miss+1)); fi;;
        P)   pacman -Qqen 2>/dev/null >"$stage/pkgs-repo.txt";;
        A)   pacman -Qqm  2>/dev/null >"$stage/pkgs-aur.txt";;
        A:*) : ;;   # resuelto en vivo por el import; no necesita fichero
      esac
    done
    printf '\033[32mok\033[0m\n'
  done
  write_manifest "$stage/manifest.txt"
  mkdir -p "$(dirname "$PAY")"
  ( cd "$stage" && tar --exclude=.git --exclude=__pycache__ -czf "$PAY" . ) || \
    { printf '\033[31m✘\033[0m tar fallo escribiendo %s\n' "$PAY"; rm -rf "$stage"; return 1; }
  cp "$stage/manifest.txt" "$PAY.manifest" 2>/dev/null || true
  printf '\n\033[1;32m✔\033[0m \033[1m%s\033[0m  %s · %s grupos · %s sin contenido\n' \
    "$PAY" "$(human "$(wc -c <"$PAY")")" "$sel" "$miss"
  (( miss > 0 )) && printf '\033[33m!\033[0m %s rutas no existian al exportar (ver columna mis)\n' "$miss"
  rm -rf "$stage"
}

write_manifest() {
  local out=$1 tn mons
  tn=$(cat "$ST/current/theme.name" 2>/dev/null); tn=${tn:-tahoe-dark}
  printf 'theme=%s\nhyprland=%s\nomarchy=%s\nfont=%s\nicons=%s\nterminal=%s\nkb_layout=%s\nkairos=%s\nweather=%s\n' \
    "$tn" \
    "$(hyprctl version 2>/dev/null | awk '/^Hyprland/{print $2; exit}')" \
    "$(omarchy version 2>/dev/null | head -1)" \
    "$(awk -F' = ' '/^font-family/{gsub(/"/,"",$2);print $2; exit}' "$CFG/ghostty/config" 2>/dev/null)" \
    "$(cat "$CFG/omarchy/themes/$tn/icons.theme" 2>/dev/null)" \
    "$(awk '!/^#/ && NF {print; exit}' "$CFG/xdg-terminals.list" 2>/dev/null)" \
    "$(hyprctl getoption input:kb_layout 2>/dev/null | awk '/^str:/{print $2}')" \
    "http://kairos:8787/api/metrics" \
    "$(jq -r '.name // "?"' "$ST/settings/weather.json" 2>/dev/null)" >"$out"
  # fallback: sin hyprctl activo, jq no emite nada y la linea quedaria pegada a gen=
  mons=$(hyprctl monitors -j 2>/dev/null | jq -r \
    '[.[]|"\(.name):\(.width)x\(.height)@\(.refreshRate):\(.scale):\(.transform)"]|join(",")')
  printf 'monitors=%s\n' "${mons:-none}" >>"$out"
  printf 'gen=%s\n' "$(cat "$ST/current/theme.generation" 2>/dev/null)" >>"$out"
}

# ─── import ─────────────────────────────────────────────────────────────────
do_import() {
  [[ -f $PAY ]] || { printf '\033[31m✘\033[0m falta el payload %s\n' "$PAY"; return 1; }
  tar -tzf "$PAY" >/dev/null 2>&1 || { printf '\033[31m✘\033[0m payload corrupto: %s\n' "$PAY"; return 1; }
  local stage; stage=$(mktemp -d)
  tar -xzf "$PAY" -C "$stage"
  local i p sel=0 t0=$SECONDS
  for ((i=1;i<=TOTAL;i++)); do
    [[ ${SEL[i]} == 1 ]] || continue
    sel=$((sel+1))
    local -a P=() tok=()
    read -ra P <<<"${SPEC[i]}"
    for p in "${P[@]}"; do
      case $p in
        c:*) install_entry "$stage/config" "$CFG" "${p#c:}";;
        s:*) install_entry "$stage/state"  "$ST"  "${p#s:}";;
        *)   tok+=("$p");;
      esac
    done
    for p in "${tok[@]}"; do
      case $p in
        P)   [[ -f $stage/pkgs-repo.txt ]] && pacman -S --needed --noconfirm $(cat "$stage/pkgs-repo.txt");;
        A)   [[ -f $stage/pkgs-aur.txt ]]  && yay -S --needed --noconfirm $(cat "$stage/pkgs-aur.txt");;
        A:*) pacman -Qq -- "${p#A:}" >/dev/null 2>&1 || pacman -S --needed --noconfirm "${p#A:}";;
      esac
    done
    printf '\033[32mok\033[0m\n'
  done
  [[ -f $stage/manifest.txt ]] && audit "$stage/manifest.txt"
  printf '\n\033[1;32m✔\033[0m %s grupos aplicados en %ss\n' "$sel" "$((SECONDS-t0))"
  rm -rf "$stage"
}

# ─── auditoria de la maquina destino ────────────────────────────────────────
audit() {
  local m=$1 k v
  local -A SRC=()
  while IFS='=' read -r k v; do [[ -n $k ]] && SRC["$k"]=$v; done <"$m"
  printf '\n\033[1;35m┌─[ auditoria · maquina destino ]\033[0m\n'

  # 1 · Hyprland (ABI de plugins + rounding_power)
  local hv; hv=$(hyprctl version 2>/dev/null | awk '/^Hyprland/{print $2; exit}')
  if [[ ${SRC[hyprland]} != "$hv" ]]; then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m hyprland  \033[2m%s →\033[0m %s\n' "${SRC[hyprland]:-?}" "${hv:-sin Hyprland}"
    if [[ -z $hv ]]; then
      printf '\033[1;35m│\033[0m   \033[2mhypprctl sin respuesta; revisa que hay sesion de Hyprland\033[0m\n'
    elif [[ ${hv#0.} =~ ^([0-9]+) ]] && (( ${BASH_REMATCH[1]} >= 55 )); then
      printf '\033[1;35m│\033[0m   \033[2mrounding_power 2.0 activo (esquinas circulares)\033[0m\n'
    else
      printf '\033[1;35m│\033[0m   \033[2m<0.55: rounding_power=2.0 se ignora, esquinas triangulares\033[0m\n'
    fi
  else
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m hyprland  %s\n' "$hv"
  fi

  # 2 · Omarchy
  local ov; ov=$(omarchy version 2>/dev/null | head -1)
  if [[ ${SRC[omarchy]} == "$ov" ]]; then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m omarchy   %s\n' "$ov"
  else
    printf '\033[1;35m│\033[0m \033[33m!\033[0m omarchy   \033[2m%s →\033[0m %s \033[2m(defaults pueden variar)\033[0m\n' "${SRC[omarchy]:-?}" "${ov:-?}"
  fi

  # 3 · monitores → reescribir monitors.lua
  local mons; mons=$(hyprctl monitors -j 2>/dev/null | jq -r \
    '[.[]|"\(.name):\(.width)x\(.height)@\(.refreshRate):\(.scale):\(.transform)"]|join(",")')
  if [[ -z $mons || $mons == "null" ]]; then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m monitores \033[2msin salida de hyprctl (¿sin sesion?)\033[0m\n'
  elif [[ $mons != "${SRC[monitors]}" ]]; then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m monitores \033[2m[%s] → [%s]\033[0m\n' "${SRC[monitors]:-?}" "$mons"
    local out="$CFG/hypr/monitors.lua" n nm wh sc tf
    : >"$out"
    printf -- '-- autogenerado por amarchy (destino)\nhl.env("GDK_SCALE", "1")\n' >>"$out"
    IFS=',' read -ra MM <<<"$mons"
    for n in "${MM[@]}"; do
      IFS=':' read -r nm wh sc tf <<<"$n"
      if [[ ${tf:-0} != 0 ]]; then
        printf 'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = %s, transform = %s })\n' \
          "$nm" "${wh/@*}" "${sc:-1}" "$tf" >>"$out"
      else
        printf 'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = %s })\n' \
          "$nm" "${wh/@*}" "${sc:-1}" >>"$out"
      fi
    done
    printf '\033[1;35m│\033[0m   \033[32m→\033[0m \033[2mreescrito hypr/monitors.lua (%s pantalla/s)\033[0m\n' "${#MM[@]}"
  else
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m monitores [%s]\n' "$mons"
  fi

  # 4 · fuente (here-string: fc-list + pipefail deja de dar SIGPIPE)
  local fn=${SRC[font]:-JetBrainsMono Nerd Font} fam
  fam=$(fc-list : family 2>/dev/null)
  if grep -qi "${fn%%,*}" <<<"$fam"; then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m fuente    %s\n' "$fn"
  elif grep -qi JetBrainsMono <<<"$fam"; then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m fuente    \033[2m%s →\033[0m %s \033[2m(usa este nombre)\033[0m\n' "$fn" "$(grep -i jetbrains <<<"$fam" | head -1)"
  else
    printf '\033[1;35m│\033[0m \033[33m!\033[0m fuente    \033[2m%s ausente\033[0m\n' "$fn"
    pacman -S --needed --noconfirm ttf-jetbrains-mono-nerd-basic >/dev/null 2>&1 \
      && printf '\033[1;35m│\033[0m   \033[32m→\033[0m \033[2minstalado ttf-jetbrains-mono-nerd-basic\033[0m\n' \
      || printf '\033[1;35m│\033[0m   \033[2minstala ttf-jetbrains-mono-nerd-basic (4 conf de terminal)\033[0m\n'
  fi

  # 5 · iconos
  local ic=${SRC[icons]:-Yaru-blue-dark}
  if [[ -d /usr/share/icons/$ic ]]; then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m iconos    %s\n' "$ic"
  else
    printf '\033[1;35m│\033[0m \033[33m!\033[0m iconos    \033[2m%s ausente\033[0m\n' "$ic"
    pacman -S --needed --noconfirm yaru-icon-theme >/dev/null 2>&1 \
      && printf '\033[1;35m│\033[0m   \033[32m→\033[0m \033[2minstalado yaru-icon-theme\033[0m\n' \
      || printf '\033[1;35m│\033[0m   \033[2minstala yaru-icon-theme\033[0m\n'
  fi

  # 6 · terminal preferido
  local tm=${SRC[terminal]:-com.mitchellh.ghostty.desktop} f found=
  if [[ -e /usr/share/applications/$tm ]]; then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m terminal  %s\n' "$tm"
  else
    for f in com.mitchellh.ghostty.desktop org.codeberg.fsfoss.terminal.kitty.desktop org.codeberg.fsfoss.terminal.foot.desktop; do
      [[ -e /usr/share/applications/$f ]] && { found=$f; break; }
    done
    if [[ -n $found ]]; then
      printf '%s\n' "$found" >"$CFG/xdg-terminals.list"
      printf '\033[1;35m│\033[0m \033[33m!\033[0m terminal  \033[2m%s →\033[0m %s \033[2m(reescrito xdg-terminals.list)\033[0m\n' "$tm" "$found"
    else
      printf '\033[1;35m│\033[0m \033[31m✘\033[0m terminal  ninguno de ghostty/kitty/foot instalado\n'
    fi
  fi

  # 7 · teclado
  local kl; kl=$(hyprctl getoption input:kb_layout 2>/dev/null | awk '/^str:/{print $2}')
  if [[ -n $kl && $kl != "${SRC[kb_layout]}" ]]; then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m teclado   \033[2morigen %s →\033[0m %s \033[2m(vale el de destino)\033[0m\n' "${SRC[kb_layout]:-nulo}" "$kl"
  else
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m teclado   %s\n' "${kl:-${SRC[kb_layout]:-default}}"
  fi

  # 8 · endpoint kairos
  if [[ -n ${SRC[kairos]:-} ]] && curl -fsS -m 3 -o /dev/null "${SRC[kairos]}" 2>/dev/null; then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m kairos    %s\n' "${SRC[kairos]}"
  else
    printf '\033[1;35m│\033[0m \033[33m!\033[0m kairos    \033[2m%s sin respuesta → amartin.kairos queda vacio\033[0m\n' "${SRC[kairos]:-?}"
  fi

  # 9 · clima + hooks
  printf '\033[1;35m│\033[0m \033[36m·\033[0m clima     %s\n' "${SRC[weather]:-?}"

  # 10 · integridad: cada id declarado en shell.json debe existir en disco
  #     (builtin en /usr/share/omarchy/shell, propios en ~/.config/omarchy/plugins)
  local miss=() known id
  if [[ -f $CFG/omarchy/shell.json ]]; then
    known=$(find /usr/share/omarchy/shell "$CFG/omarchy/plugins" -name '*manifest.json' -exec jq -r '.id // empty' {} + 2>/dev/null
      ls /usr/share/omarchy/shell/bar/modules/*.qml "$CFG"/omarchy/bar/modules/*.qml 2>/dev/null | sed 's#.*/##; s/\.qml$//')
    known=$(sort -u <<<"$known")
    while read -r id; do
      [[ -n $id ]] || continue
      grep -qxF "$id" <<<"$known" || miss+=("$id")
    done < <(jq -r '[.bar.layout[][], .plugins[] | .id? // empty] | .[]' "$CFG/omarchy/shell.json" 2>/dev/null)
  fi
  if (( ${#miss[@]} == 0 )); then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m widgets   ids de la barra resueltos\n'
  else
    printf '\033[1;35m│\033[0m \033[33m!\033[0m widgets   \033[2m%s sin plugin:\033[0m %s\n' "${#miss[@]}" "${miss[*]}"
  fi

  # 11 · plugins hyprpm vs build de Hyprland (ABI)
  local cache="/var/cache/hyprpm/$(id -un)" stale=() have=() so hypr_bin=${HYPRLAND_BIN:-/usr/bin/Hyprland}
  for so in "$cache/hyprland-plugins/hyprbars.so" "$cache/hymission/hymission.so"; do
    [[ -f $so ]] || continue
    have+=("$(basename "$so" .so)")
    [[ $hypr_bin -nt $so ]] && stale+=("$(basename "$so" .so)")
  done
  if (( ${#have[@]} == 0 )); then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m hyprpm    \033[2msin .so en %s; sin titulos ni Mission Control\033[0m\n' "$cache"
  elif (( ${#stale[@]} )); then
    printf '\033[1;35m│\033[0m \033[33m!\033[0m hyprpm    \033[2m%s mas nuevo que %s\033[0m\n' \
      "$(basename "$hypr_bin")" "${stale[*]}"
    if command -v hyprpm >/dev/null 2>&1; then
      printf '\033[1;35m│\033[0m   \033[2m→ hyprpm update y reiniciar Hyprland\033[0m\n'
    else
      printf '\033[1;35m│\033[0m   \033[2m→ hyprpm no esta en PATH; los .so actuales siguen cargando\033[0m\n'
    fi
  else
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m hyprpm    %s contra esta build\n' "${have[*]}"
  fi
  printf '\033[1;35m╰─\033[0m\n'
}

# ─── aplicacion ─────────────────────────────────────────────────────────────
finalize() {
  local tn; tn=$(cat "$ST/current/theme.name" 2>/dev/null); tn=${tn:-tahoe-dark}
  printf '\n\033[1;35m┌─[ aplicar ]\033[0m \033[2m%s\033[0m\n' "$tn"
  step "hyprpm update"  hyprpm update
  step "theme set"      omarchy theme set "$tn"
  step "restart shell"  omarchy restart shell
  step "restart term"   omarchy restart terminal
  step "hyprctl reload" hyprctl reload
  local err; err=$(hyprctl configerrors 2>&1)
  if [[ -z ${err//[[:space:]]/} ]]; then
    printf '\033[1;35m│\033[0m \033[32m✓\033[0m configerrors  \033[2msin errores\033[0m\n'
  else
    printf '\033[1;35m│\033[0m \033[31m✘\033[0m configerrors\n'
    while IFS= read -r l; do printf '\033[1;35m│\033[0m     %s\n' "$l"; done <<<"$err"
  fi
  printf '\033[1;35m╰─\033[0m\n'
}
step() {
  local lbl=$1; shift
  if "$@" >/dev/null 2>&1; then printf '\033[1;35m│\033[0m \033[32m✓\033[0m %-15s\033[2mok\033[0m\n' "$lbl"
  else printf '\033[1;35m│\033[0m \033[2m· %s  omitido\033[0m\n' "$lbl"; fi
}

# ─── estado ─────────────────────────────────────────────────────────────────
env_summary() {
  printf '\n\033[1;35m┌─[ entorno ]\033[0m\n'
  printf '\033[1;35m│\033[0m omarchy      %s\n' "$(omarchy version 2>/dev/null | head -1)"
  printf '\033[1;35m│\033[0m hyprland     %s\n' "$(hyprctl version 2>/dev/null | awk '/^Hyprland/{print $2; exit}')"
  printf '\033[1;35m│\033[0m tema         %s\n' "$(cat "$ST/current/theme.name" 2>/dev/null)"
  printf '\033[1;35m│\033[0m iconos       %s\n' "$(cat "$CFG/omarchy/themes/$(cat "$ST/current/theme.name" 2>/dev/null)/icons.theme" 2>/dev/null)"
  printf '\033[1;35m│\033[0m terminal     %s\n' "$(awk '!/^#/ && NF {print; exit}' "$CFG/xdg-terminals.list" 2>/dev/null)"
  printf '\033[1;35m│\033[0m hyprpm       %s\n' "$(command -v hyprpm || echo 'no en PATH (los .so siguen cargando desde hypr/plugins.lua)')"
  printf '\033[1;35m│\033[0m plugins      %s\n' "$(hyprctl plugins list 2>/dev/null | awk '/^Plugin /{print $2}' | sort -u | tr '\n' ' ')"
  printf '\033[1;35m│\033[0m monitores    %s\n' "$(hyprctl monitors -j 2>/dev/null | jq -r '[.[]|"\(.name) \(.width)x\(.height)@\(.refreshRate) s\(.scale)"]|join(" | ")')"
  printf '\033[1;35m╰─\033[0m\n'
}

payload_info() {
  [[ -f $PAY ]] || { printf '\n\033[33m!\033[0m sin payload en %s\n' "$PAY"; return; }
  printf '\n\033[1;35m┌─[ payload ]\033[0m \033[2m%s\033[0m\n' "$(human "$(wc -c <"$PAY")")"
  printf '\033[1;35m│\033[0m entradas     %s\n' "$(tar -tzf "$PAY" | wc -l)"
  if [[ -f "$PAY.manifest" ]]; then
    while IFS= read -r l; do printf '\033[1;35m│\033[0m %s\n' "${l/=/: }"; done <"$PAY.manifest"
  else
    printf '\033[1;35m│\033[0m \033[33m!\033[0m sin .manifest (export anterior); el audit se omite\n'
  fi
  printf '\033[1;35m╰─\033[0m\n'
}

# ─── bucle ──────────────────────────────────────────────────────────────────
MODE=export
[[ -f $PAY ]] && MODE=import

while true; do
  menu
  printf '\n\033[2m%s\033[0m  ' "[1-$TOTAL] toggle · a/n/r · e export · i import · s entorno · p payload · h ayuda · q salir"
  read -r ans || break
  ans=${ans//[[:space:]]/}          # " q " y "8" tratan igual
  if [[ -z $ans ]]; then
    if [[ $MODE == import ]]; then do_import && finalize; else do_export; fi
    break
  fi
  case $ans in
    a|A) for ((i=1;i<=TOTAL;i++)); do SEL[i]=1; done;;
    n|N) for ((i=1;i<=TOTAL;i++)); do SEL[i]=0; done;;
    r|R) for ((i=1;i<=TOTAL;i++)); do SEL[i]=1; done;;
    e|E) do_export; MODE=import;;
    i|I) do_import && finalize; MODE=import;;
    s|S) env_summary;;
    p|P) payload_info;;
    h|H|'?'|f) help;;
    q|Q) break;;
    *)   # base 10 explicita: "08" no es octal validoy romperia (( )).
         if [[ $ans =~ ^[0-9]+$ ]] && (( 10#$ans >= 1 && 10#$ans <= TOTAL )); then
           ans=$((10#$ans))
           [[ ${SEL[ans]} == 1 ]] && SEL[ans]=0 || SEL[ans]=1
         else
           printf '\033[33m!\033[0m "%s" no es una opcion valida (1-%s, a, n, r, e, i, s, p, h, q)\n' "$ans" "$TOTAL"
         fi;;
  esac
done
